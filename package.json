{
  "name": "@dsh-extra/dsh-actors",
  "version": "0.1.0",
  "description": "数字分身 · 对话者注册表：多渠道身份归一、角色锚定（主人/同事/客户/生人/黑名单）、fail-closed 未注册隔离。实施计划 T1。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/registry.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.0"
  }
}
